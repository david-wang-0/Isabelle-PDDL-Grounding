chapter AFP

session Classical_Reachability_Analysis = Grounding_Classical_Common +
  description \<open>Reachability analysis for a normalized, relaxed PDDL problem: the shared
    PDDL-to-datalog infrastructure and the datalog-certificate kernel (PDDL reachability as the
    minimal model of the translated program) that feeds the grounder. The untrusted forward-chaining
    oracle is now the generic Datalog_Evaluation in the Datalog_Certification session.\<close>
  options [timeout = 900]
  sessions
    "Datalog_Certification"
    "Grounding_Reachability_Analysis"
    "Classical_Grounded_PDDL"
    "Classical_PDDL_Relaxation"
  theories
    Classical_Reachability_Analysis
    Classical_PDDL_Reachability_Locales
    Classical_PDDL_Reachability_Analysis
    Classical_PDDL_Reachability_Certificate
    Classical_Certified_Grounding_Locales
    Classical_Cert_Ops_Index
    Classical_Certified_Grounding
    Classical_Certified_Grounding_Semantics
